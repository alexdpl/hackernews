# ==============================================================================
# DevKernelPulse (DKP Kernel v2.6-PURE-SQL) - Environment Template
# Copy to .env and fill with real secrets (never commit .env!)
# ==============================================================================

# Runtime & Public Site
NODE_ENV=development
PORT=8080
HOST=0.0.0.0
NUXT_PUBLIC_SITE_URL=https://devkernelpulse.org

# Neon PostgreSQL (Pure SQL)
DATABASE_URL=postgresql://user:password@ep-example.eu-central-1.aws.neon.tech/dkp?sslmode=require

# Session & Auth Security
JWT_SECRET=replace_with_64_char_random_hex_secret
SESSION_SECRET=replace_with_64_char_random_hex_session_secret

# DKP Sentinel AI & Grammar Nexus
OPENROUTER_API_KEY=sk-or-v1-placeholder
OPENAI_API_KEY=sk-proj-placeholder
GEMINI_API_KEY=AIzaSy-placeholder
DKP_SENTINEL_MASTER_KEY=dkp_live_example_sentinel_master_key

# Mail Nexus (SMTP / Transactional)
MAIL_NEXUS_HOST=smtp.example.com
MAIL_NEXUS_PORT=587
MAIL_NEXUS_USER=noreply@devkernelpulse.org
MAIL_NEXUS_PASS=replace_with_smtp_password
MAIL_NEXUS_FROM="DevKernelPulse <noreply@devkernelpulse.org>"

# Stripe Shop & SaaS Keys
STRIPE_SECRET_KEY=sk_test_placeholder
STRIPE_WEBHOOK_SECRET=whsec_placeholder
NUXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_placeholder